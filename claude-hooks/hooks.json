{
  "description": "Claude Code only: name Revnu at session start and keep a revnu@revnu install current",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/claude-hooks/session-start.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
